# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdz?schema=public"

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token (from @BotFather). Used ONLY server-side to validate initData.
TELEGRAM_BOT_TOKEN=
# Bot username (used to build referral links), e.g. "my_school_helper_bot"
TELEGRAM_BOT_USERNAME=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign user session tokens (openssl rand -hex 32)
AUTH_SECRET=
# Grace credits given on first registration (welcome balance)
DEFAULT_BALANCE=5
# Allow mock auth in development (no Telegram installed). Keep false in production!

# ─── AI (OpenRouter / Bitcoin.com AI) ──────────────────────────────────────
# Provider: "mock" | "openrouter" | "bitcoincom"
# If left at "mock", the provider is auto-detected from whichever API key is set.
AI_PROVIDER=mock
# Route the "answer" mode to a cheap model (Gemini 2.5 Flash Lite). false → always main model.
AI_CHEAP_MODE=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
OPENROUTER_CHEAP_MODEL=google/gemini-2.5-flash-lite

# Bitcoin.com AI — OpenAI-compatible API on top of nano-gpt.
# The ai.bitcoin.com key works directly on https://api.nano-gpt.com/api/v1
BITCOINCOM_API_KEY=
BITCOINCOM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
BITCOINCOM_CHEAP_MODEL=gemini-2.5-flash-lite
BITCOINCOM_BASE_URL=https://nano-gpt.com/api/v1

# AI request timeout in milliseconds
AI_TIMEOUT_MS=120000

# Retries on transient network errors (connection timeouts etc.)
AI_RETRIES=2
AI_RETRY_DELAY_MS=1000

# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app (used for links/callbacks)
APP_URL=http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
# Provider: "local" | "s3"
STORAGE_PROVIDER=local
# Local storage directory (only for "local" provider)
STORAGE_LOCAL_DIR=uploads

# S3-compatible storage (reserved for the future, "s3" provider)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Provider: "mock" | "telegram-stars"
PAYMENT_PROVIDER=mock
# Allow the mock webhook to complete payments (dev only). Keep false in production!
ALLOW_MOCK_PAYMENTS=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Referral ─────────────────────────────────────────────────────────────────
# Credits awarded to a referrer when the referred user completes their first payment
REFERRAL_REWARD=5
