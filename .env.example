# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gdz?schema=public"

# ─── Telegram ────────────────────────────────────────────────────────────────
# Bot token (from @BotFather). Used ONLY server-side to validate initData.
TELEGRAM_BOT_TOKEN=
# Bot username (used to build referral links), e.g. "my_school_helper_bot"
TELEGRAM_BOT_USERNAME=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Secret used to sign user session tokens (openssl rand -hex 32)
AUTH_SECRET=
# Grace credits given on first registration (welcome balance)
DEFAULT_BALANCE=5
# Allow mock auth in development (no Telegram installed). Keep false in production!
ALLOW_MOCK_AUTH=false

# ─── AI (OpenRouter) ──────────────────────────────────────────────────────────
# Provider: "mock" | "openrouter" | "bitcoincom"
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# AI request timeout in milliseconds
AI_TIMEOUT_MS=120000

# ─── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app (used for links/callbacks)
APP_URL=http://localhost:3000

# ─── Storage ──────────────────────────────────────────────────────────────────
# Provider: "local" | "s3"
STORAGE_PROVIDER=local
# Local storage directory (only for "local" provider)
STORAGE_LOCAL_DIR=uploads

# S3-compatible storage (reserved for the future, "s3" provider)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=

# ─── Payments ─────────────────────────────────────────────────────────────────
# Provider: "mock" | "telegram-stars"
PAYMENT_PROVIDER=mock
# Allow the mock webhook to complete payments (dev only). Keep false in production!
ALLOW_MOCK_PAYMENTS=true

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ─── Referral ─────────────────────────────────────────────────────────────────
# Credits awarded to a referrer when the referred user completes their first payment
REFERRAL_REWARD=5
